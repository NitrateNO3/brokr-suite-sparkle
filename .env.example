# ---------------------------------------------------------------------------
# BrokrSuite — environment template
# Copy to `.env` and fill in. The web app and the Android shell share the same
# backend, so both read the same values.
# ---------------------------------------------------------------------------

# Backend (Lovable Cloud) — exposed to the browser, safe to publish.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Server-side copies used by SSR / server functions.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="your-project-ref"

# ---------------------------------------------------------------------------
# Android / Capacitor
# ---------------------------------------------------------------------------

# Origin the native shell loads. Defaults to the published Lovable URL.
# Point this at your own domain when you deploy elsewhere, then re-run `npx cap sync`.
CAP_SERVER_URL="https://brokr-suite-sparkle.lovable.app"

# Release signing — only needed for `npm run android:release`.
# Create the keystore with:
#   keytool -genkey -v -keystore brokrsuite.keystore -alias brokrsuite \
#     -keyalg RSA -keysize 2048 -validity 10000
ANDROID_KEYSTORE_PATH="/absolute/path/to/brokrsuite.keystore"
ANDROID_KEYSTORE_PASSWORD=""
ANDROID_KEYSTORE_ALIAS="brokrsuite"
ANDROID_KEYSTORE_ALIAS_PASSWORD=""
